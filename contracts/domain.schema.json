{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "入境游服务编排器领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "IDENTITY_VERIFIED",
        "PLAN_PROPOSED",
        "HOLD_CONFIRMED",
        "PARTNER_FAILED",
        "REFUND_COMPLETED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "traveler_profile",
        "journey_plan",
        "service_hold",
        "travel_credential"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
